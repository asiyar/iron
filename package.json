{
  "name": "ironpulse",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "IronPulse — Expo (React Native) tabanlı antrenman, anatomi ve performans takip uygulaması.",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "anatomy:build": "node scripts/build_bodyparts3d_glb.mjs",
    "anatomy:validate": "node scripts/validate-anatomy-glb.mjs",
    "audit:wger": "node scripts/audit-wger-media.mjs",
    "audit:videos": "node scripts/validate-external-video-guides.mjs",
    "server": "tsx server/_core/index.ts",
    "assets:brand": "python3 scripts/generate-brand-assets.py",
    "build:android": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile production-apk",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.7.0",
    "@trpc/react-query": "^11.7.0",
    "@trpc/server": "^11.7.0",
    "body-muscles": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.6",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-three": "^8.0.0",
    "expo-video": "~57.0.3",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "~0.10.1",
    "superjson": "^2.2.2",
    "three": "^0.166.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "~19.2.0",
    "@types/three": "^0.166.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "expo-three": {
      "react": "19.2.3",
      "react-native": "0.86.3"
    }
  }
}
